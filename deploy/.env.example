# 复制为 .env 后修改。缺这个文件 compose 会直接拒启（密钥是必填项）。

# 对外域名（HTTPS 用，本地开发不生效）
HANBOT_DOMAIN=localhost

# 会话签名密钥：32 字符以上的随机串。
# 生产模式（HTTPS）下，默认值/示例值/过短值会在启动时被拒绝。
HANBOT_SECRET=please-change-me-to-a-random-32+-char-string

# 数据加密密钥：API 密钥等敏感字段 AES-256-GCM 加密落库的主密钥（32 字符以上）。
# 注意：此密钥一旦使用就不可更换——换了将解不开库里已存的密钥字段。
# 生产模式（HTTPS）下，默认值/空值/过短值会在启动时被拒绝。
HANBOT_DATA_KEY=please-change-me-to-another-random-32+-string

# 单用户：用户名 + 首次启动初始密码（创建后即失效，改密码走数据库/后续设置页）
# 生产模式下空值/默认值同样拒启。
HANBOT_USERNAME=han
HANBOT_INITIAL_PASSWORD=please-change-me

# pip 源（默认阿里云，海外部署改回官方）
# PIP_INDEX_URL=https://pypi.org/simple/

# Linux 生产机部署提醒：backend 以 uid 1000 运行，数据目录需可写：
#   chown -R 1000:1000 data/
